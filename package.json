{
  "name": "observable-cli",
  "version": "1.0.7",
  "description": "Observability CLI tool - log search, distributed tracing, alarm event analysis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "omc": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --import tsx/esm src/index.tsx",
    "build": "tsc && rm -rf dist/prompts && cp -r src/prompts dist/prompts",
    "start": "node dist/index.js",
    "test": "node --import tsx/esm --test src/memory.test.ts"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.70.6",
    "@mariozechner/pi-ai": "^0.70.6",
    "@sinclair/typebox": "^0.34.49",
    "chalk": "^5.6.2",
    "ink": "^5.2.0",
    "marked": "^18.0.2",
    "pino": "^10.3.1",
    "react": "^18.3.1",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.28",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
